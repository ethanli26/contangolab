# Copy to .env and fill in. Never commit the real .env (it is in .gitignore).

# Databento (CME Globex data). Only needed to download; everything else runs from data/cache/.
DATABENTO_API_KEY=

# Folder with the China exchange files (futures_daily.csv, contract_specs.csv, receipts.csv).
# Defaults to data/cache/futures_cn.
# FUTURES_CN_DIR=

# EIA open-data key, only needed to download US inventory series (markets/inventory.py).
# EIA_API_KEY=
